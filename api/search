LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86","tags":[],"type":"text","url":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86#小结","content":"本节只需要先记住："},"2872":{"id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86-136","page_id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86","tags":[],"type":"text","url":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86#小结","content":"> **`Checkpointer`** 负责保存检查点\n>\n> **`thread_id`** 负责唯一标识会话\n>\n> **`checkpoint_id`** 负责定位某个具体历史状态\n>\n> **`StateSnapshot`** 是开发者查看检查点时看到的对象。"},"2873":{"id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86-137","page_id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86","tags":[],"type":"text","url":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86#什么是langgraph的可恢复执行","content":"**`LangGraph`** 的可恢复执行（**`Durable Execution`**）依托于其持久化机制（**`Persistence`**）。"},"2874":{"id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86-138","page_id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86","tags":[],"type":"text","url":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86#什么是langgraph的可恢复执行","content":"可以简单理解为："},"2875":{"id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86-139","page_id":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5%8C%96%E4%B8%8E%E8%AE%B0%E5%BF%86%E7%AE%A1%E7%90%86","tags":[],"type":"text","url":"/docs/ai/langgraph/03-LangGraph%E6%8C%81%E4%B9%85%E5