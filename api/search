atabase/base/multi_table_query-10","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#右外连接","content":"右外连接"},"6306":{"id":"/docs/backend/database/base/multi_table_query-11","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"UNION 的使用"},"6307":{"id":"/docs/backend/database/base/multi_table_query-12","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#sql-joins总结","content":"SQL JOINS(总结)"},"6308":{"id":"/docs/backend/database/base/multi_table_query-13","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#交叉连接","content":"交叉连接"},"6309":{"id":"/docs/backend/database/base/multi_table_query-14","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#内连接-1","content":"内连接"},"6310":{"id":"/docs/backend/database/base/multi_table_query-15","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#左外连接-1","content":"左外连接"},"6311":{"id":"/docs/backend/database/base/multi_table_query-16","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#右外连接-1","content":"右外连接"},"6312":{"id":"/docs/backend/database/base/multi_table_query-17","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#左排除外连接左表唯一","content":"左排除外连接(左表唯一)"},"6313":{"id":"/docs/backend/database/base/multi_table_query-18","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#右排除外连接右表唯一","content":"右排除外连接(右表唯一)"},"6314":{"id":"/docs/backend/database/base/multi_table_query-19","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#全外连接","content":"全外连接"},"6315":{"id":"/docs/backend/database/base/multi_table_query-20","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#非交集连接","content":"非交集连接"},"6316":{"id":"/docs/backend/database/base/multi_table_query-21","page_id":"/docs/backend/database/base/multi_table_query","type":"heading","tags":[],"url":"/docs/backend/database/base/multi_table_query#附图-sql-joins","content":"附图 SQL JOINS"},"6317":{"id":"/docs/backend/database/base/multi_table_query-22","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query","content":"多表查询，也称为关联查询，指两个或更多个表一起完成查询操作。  \n**前提条件**：这些一起查询的表之间是有关系的(一对一、一对多)，它们之间一定是有关联字段，这个关联字段可能建立了外键，也可能没有建立外键。"},"6318":{"id":"/docs/backend/database/base/multi_table_query-23","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#笛卡尔积","content":"&#8195;&#8195;如果连接条件无效或者遗漏，其结果就是一个笛卡尔积，其中所有行的组合都被显示出来，即第一个表中的所有行连接到第二个表中的所有行。  \n&#8195;&#8195;笛卡尔积会产生大量的行，例如第一个表中有 100 条记录，第二个表中有 200 条记录，使用笛卡尔积，结果就是两者相乘的 20000 条记录。一般来说这样的数据没有什么用，所以要避免此类情况出现。"},"6319":{"id":"/docs/backend/database/base/multi_table_query-24","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#等值连接","content":"&#8195;&#8195;在多表连接查询的 SELECT 子句中，字段名前面用表名可以使语义清楚，并且加快数据库访问，提高性能；如果相同的字段名出现在多个表中，字段名必须加表名，否则会引起冲突。 为了将 N 个表连接在一起，至少需要 N-1 个连接条件。"},"6320":{"id":"/docs/backend/database/base/multi_table_query-25","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#多表等值连接","content":"&#8195;&#8195;在 SQL 语句中的`WHERE`子句里，用`AND`将两个连接条件结合起来，像这样的连接称为多表的等值查询。其核心表是`table1`，分别通过`column1`与表`table2`关联，通过`column2`与表`table3`关联。"},"6321":{"id":"/docs/backend/database/base/multi_table_query-26","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#表别名","content":"&#8195;&#8195;为了提高性能、避免字段名冲突，在多表连接查询的 SELECT 子句中，应该以`表名.字段名`的方式命名。不过这么写比较繁琐，可以使用表别名解决。  \n&#8195;&#8195;表别名就是给表起了另外一个名字，不过字段别名通常是为了显示字段标题易于理解而起，而表别名是为了让 SQL 语句简单、易读。注意给表取别名后则不能使用\"表名.字段名\"的形式了，而需要使用\"表别名.字段名\"。"},"6322":{"id":"/docs/backend/database/base/multi_table_query-27","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#表别名","content":"**示例**："},"6323":{"id":"/docs/backend/database/base/multi_table_query-28","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#自连接自关联","content":"&#8195;&#8195;将同一张`employees`表通过别名看成了两张不同的表；将别名 a 的表看成员工表，别名 b 的表看成领导表，在将两表进行连接。"},"6324":{"id":"/docs/backend/database/base/multi_table_query-29","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"**内连接**：在标准 SQL 中，将多个表连接，仅返回匹配条件的行的连接。简单来说，就是查询出来的结果在两个或多个表里都有与之匹配的记录。"},"6325":{"id":"/docs/backend/database/base/multi_table_query-30","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"**SQL92 语法**："},"6326":{"id":"/docs/backend/database/base/multi_table_query-31","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"**SQL99 语法**："},"6327":{"id":"/docs/backend/database/base/multi_table_query-32","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"① `INNER`可以省略！"},"6328":{"id":"/docs/backend/database/base/multi_table_query-33","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"② **自然连接**：如果两个表中，有相同的字段名且字段的数据类型相同，则可以使用自然连接实现两个表之间的等值连接，自然连接是一种特殊的等值连接。"},"6329":{"id":"/docs/backend/database/base/multi_table_query-34","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#内连接","content":"③ **USING 子句**：上面的 SQL，除了可以使用自然连接，还可以使用`USING`子句来明确指定连接字段。"},"6330":{"id":"/docs/backend/database/base/multi_table_query-35","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#外连接","content":"**外连接**：合并具有同一列的两个及以上的表的行，结果集中除了包含一个表与另一个表匹配的行之外，还查询出了左表或右表中不匹配的行。"},"6331":{"id":"/docs/backend/database/base/multi_table_query-36","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#外连接","content":"**外连接的分类**：左外连接(`LEFT [OUTER] JOIN ... ON`)、右外连接(`RIGHT [OUTER] JOIN ... ON`)、全外连接(`FULL [OUTER] JOIN ... ON`)，但是MySQL 在 SQL99 语法中不支持全外连接(满外连接)。"},"6332":{"id":"/docs/backend/database/base/multi_table_query-37","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#外连接","content":"MySQL 不支持 SQL92 语法中外连接的写法(使用+)，但是 Oracle 中这样的写法可以！MySQL 支持 SQL99 语法中使用`JOIN ... ON`的方式实现多表的查询。"},"6333":{"id":"/docs/backend/database/base/multi_table_query-38","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#左外连接","content":"> 左表匹配数据全部展示，右表不匹配的数据展示为 NULL"},"6334":{"id":"/docs/backend/database/base/multi_table_query-39","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#右外连接","content":"> 右表匹配数据全部展示，左表不匹配的数据展示为 NULL"},"6335":{"id":"/docs/backend/database/base/multi_table_query-40","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#右外连接","content":"① `OUTER`可以省略！"},"6336":{"id":"/docs/backend/database/base/multi_table_query-41","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#右外连接","content":"② 有相同的字段名且字段的数据类型相同可以使用`USING`子句。"},"6337":{"id":"/docs/backend/database/base/multi_table_query-42","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"合并查询结果利用 UNION 关键字，可以给出多条 SELECT 语句，并将它们的结果组合成单个结果集。合并时，两个表对应的列数和数据类型必须相同，并且相互对应。各个 SELECT 语句之间使用 UNION 或 UNION ALL 关键字分隔。"},"6338":{"id":"/docs/backend/database/base/multi_table_query-43","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"**语法格式**："},"6339":{"id":"/docs/backend/database/base/multi_table_query-44","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"| UNION | UNION ALL |\n| ----- | --------- |\n|       |           |","table":"table-0"},"6340":{"id":"/docs/backend/database/base/multi_table_query-45","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"| UNION                | UNION ALL             |\n| -------------------- | --------------------- |\n| 返回两个查询的结果集的并集，去除重复记录 | 返回两个查询的结果集的并集，不去除重复记录 |","table":"table-0"},"6341":{"id":"/docs/backend/database/base/multi_table_query-46","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#union-的使用","content":"执行 UNION ALL 语句时所需要的资源比 UNION 语句少。如果明确知道合并数据后的结果数据不存在重复数据，或者不需要去除重复的数据，则尽量使用 UNION ALL 语句，以提高数据查询的效率。"},"6342":{"id":"/docs/backend/database/base/multi_table_query-47","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#sql-joins总结","content":"假设有`TableA`和`TableB`两张表，示例数据如下图所示，且红色高亮部分表示两个表的匹配数据。"},"6343":{"id":"/docs/backend/database/base/multi_table_query-48","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#sql-joins总结","content":"参考地址：https://learnsql.com/blog/sql-joins/"},"6344":{"id":"/docs/backend/database/base/multi_table_query-49","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#sql-joins总结","content":"测试数据"},"6345":{"id":"/docs/backend/database/base/multi_table_query-50","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#左排除外连接左表唯一","content":"> 相当于左外连接去除两表匹配部分，剩下的为左表与右表不匹配的数据，而这些数据由于不匹配的缘故，右表不存在则展示为`null`"},"6346":{"id":"/docs/backend/database/base/multi_table_query-51","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#右排除外连接右表唯一","content":"> 相当于右外连接去除两表匹配部分，剩下的为左表与右表不匹配的数据，而这些数据由于不匹配的缘故，左表不存在则展示为`null`"},"6347":{"id":"/docs/backend/database/base/multi_table_query-52","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#非交集连接","content":"> 相当于全外连接去除两表匹配部分，剩下的为左表与右表不匹配的数据，而这些数据由于不匹配的缘故，左表或右表中不存在则展示为`null`"},"6348":{"id":"/docs/backend/database/base/multi_table_query-53","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#非交集连接","content":"我们要控制连接表的数量。多表连接就相当于嵌套 for 循环一样，非常消耗资源，会让 SQL 查询性能下降得很严重，因此不要连接不必要的表。在许多 DBMS 中，也都会有最大连接表的限制。"},"6349":{"id":"/docs/backend/database/base/multi_table_query-54","page_id":"/docs/backend/database/base/multi_table_query","tags":[],"type":"text","url":"/docs/backend/database/base/multi_table_query#非交集连接","content":"> 【强制】超过三个表禁止 join。需要 join 的字段，数据类型保持绝对一致；多表关联查询时， 保证被关联的字段需要有索引。  \n> 说明：即使双表 join 也要注意表索引、SQL 性能。  \n> 来源：阿里巴巴《Java 开发手册》"},"6350":{"id":"/docs/backend/database/base/new_features","page_id":"/docs/backend/database/base/new_features","type":"page","content":"MySQL 8.0其它新特性","breadcrumbs":["主页","后端","数据库","MySQL基础篇"],"tags":[],"url":"/docs/backend/database/base/new_features"},"6351":{"id":"/docs/backend/database/base/new_features-0","page_id":"/docs/backend/database/base/new_features","type":"heading","tags":[],"url":"/docs/backend/database/base/new_features#mysql-8-新特性概述","content":"MySQL 8 新特性概述"},"6352":{"id":"/docs/backend/database/base/new_features-1","page_id":"/docs/backend/database/base/new_features","type":"heading","tags":[],"url":"/docs/backend/database/base/new_features#新增特性","content":"新增特性"},"6353":{"id":"/docs/backend/database/base/new_features-2","page_id":"/docs/backend/database/base/new_features","type":"heading","tags":[],"url":"/docs/backend/database/base/new_features#更简便的-nosql-支持","content":"更简便的 NoSQL 支持"},"6354":{"id":"/docs/backend/database/base/new_features-3","page_id":"/docs/backend/database/base/new_features","type":"heading","tags":[],"url":"/docs/backend/database/base/new_features#更好的索引","content":"更好的索引"},"6355":{"id":"/docs/backend/database/base/new_features-4","page_id":"/docs/backend/database/base/new_features","type":"heading","tags":[],"url":"/docs/backend/database/base/new_features#更完善的-json-支持","content":"更完善的 JSON 支持"},"6356":{"id":"/docs/backend/database/base/new_features-5","page_id":"/docs/backend/database/base/new_features","t