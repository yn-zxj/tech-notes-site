LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-204","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"`AIMessage`：AI 的回复消息；"},"1853":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-205","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"`SystemMessage`：系统提示消息；"},"1854":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-206","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"`ToolMessage`：工具调用的结果消息。"},"1855":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-207","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"`add_messages` 处理的是对话消息序列，而非普通的字符串列表。"},"1856":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-208","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"`BaseMessage` 包含一个可选的 `id` 属性，用于唯一标识一条消息。`add_messages` 在合并 `left` 与 `right` 时，不是简单地执行列表拼接，而是依据消息的 `id` 进行合并："},"1857":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-209","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"若 `right` 中的某条消息的 `id` 在 `left` 中不存在，则将该消息追加到结果列表末尾；"},"1858":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-210","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"若 `right` 中的某条消息的 `id` 与 `left` 中已有消息的 `id` 相同，则使用 `right` 中的新消息替换 `left` 中的旧消息。"},"1859":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-211","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"因此，`add_messages` 的作用可以概括为：在保留历史消息的基础上追加新消息，并允许通过相同的消息 `id` 覆盖已有消息。"},"1860":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-212","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"需要特别说明，`add_messages` 并非简单地对 `left` 与 `right` 求“并集”。更准确地说，它是一个基于消息 `id` 的消息列表合并函数：既支持追加新消息，也支持更新已有消息。"},"1861":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-213","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"可以理解为："},"1862":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-214","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"但若 `right` 中存在与 `left` 相同 `id` 的消息，则最终结果中不会出现重复消息，而是用 `right` 中的消息覆盖 `left` 中对应的旧消息。"},"1863":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-215","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"示例代码如下"},"1864":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-216","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"输出如下"},"1865":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-217","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#langgraphgraphmessageadd_messages","content":"⚠️ `id`相同，但是消息的类型不同，此时合并`right` 中存在与 `left` 相同 `id` 的消息，`left` 被覆盖。"},"1866":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-218","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#默认行为","content":"如果某个 State 字段没有显式定义 `Reducer`，LangGraph 会使用默认的状态更新行为：后一次更新值会覆盖该字段原有的状态值。"},"1867":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-219","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8#默认行为","content":"换句话说，当节点返回的更新结果中包含某个字段时，如果该字段没有配置 Reducer，LangGraph 不会对新旧值进行追加、合并或累加，而是直接使用本次返回的新值替换原来的旧值。"},"1868":{"id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8-220","page_id":"/docs/ai/langgraph/01-LangGraph%E5%9F%BA%E7%A1%80%E5%85%A5%E9%97%A8","tags":[],"type":"text","url":"/docs/ai/lang