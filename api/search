/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2-112","page_id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2","tags":[],"type":"text","url":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2#基础hitl模式的实现","content":"调用 **`interrupt()`** 可以暂停状态图的执行，并等待外部输入后恢复运行。因此它是实现 **`HITL`** 的核心机制。"},"3549":{"id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2-113","page_id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2","tags":[],"type":"text","url":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2#基础hitl模式的实现","content":"不过，仅仅调用 **`interrupt()`** 并不一定构成 **`HITL`**。只有当中断后的决策、输入或修改确实由人类完成时，才能称为 **`HITL`**；如果恢复数据完全由程序自动提供，本质上仍然是普通的中断与恢复机制。"},"3550":{"id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2-114","page_id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2","tags":[],"type":"text","url":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2#基础hitl模式的实现","content":"**示例如下**"},"3551":{"id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2-115","page_id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2","tags":[],"type":"text","url":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2#基础hitl模式的实现","content":"**运行结果如下**"},"3552":{"id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%83%A8%E7%BD%B2-116","page_id":"/docs/ai/langgraph/04-LangGraph%E4%B8%AD%E6%96%AD%E4%B8%8E%E5%B7%A5%E5%85%B7%E4%B8%8E%E9%8