database/base/aggregate_function-15","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function","content":"多行函数可以操作成组的多个行，每个行组返回一个结果，这些函数又称组函数。"},"5619":{"id":"/docs/backend/database/base/aggregate_function-16","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数           | 说明                     |\n| ------------ | ---------------------- |\n| `AVG(input)` | 求平均值，忽略空值且考虑重复值 [数字类型] |","table":"table-0"},"5620":{"id":"/docs/backend/database/base/aggregate_function-17","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数           | 说明                   |\n| ------------ | -------------------- |\n| `SUM(input)` | 求和，忽略空值且考虑重复值 [数字类型] |","table":"table-0"},"5621":{"id":"/docs/backend/database/base/aggregate_function-18","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数           | 说明          |\n| ------------ | ----------- |\n| `MAX(input)` | 求最大值 [任意类型] |","table":"table-0"},"5622":{"id":"/docs/backend/database/base/aggregate_function-19","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数           | 说明          |\n| ------------ | ----------- |\n| `MIN(input)` | 求最小值 [任意类型] |","table":"table-0"},"5623":{"id":"/docs/backend/database/base/aggregate_function-20","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数                | 说明              |\n| ----------------- | --------------- |\n| `COUNT(*\\|input)` | 求行数(用\\*则包括空值的行) |","table":"table-0"},"5624":{"id":"/docs/backend/database/base/aggregate_function-21","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数              | 说明          |\n| --------------- | ----------- |\n| `STDDEV(input)` | 求标准差 [数字类型] |","table":"table-0"},"5625":{"id":"/docs/backend/database/base/aggregate_function-22","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#常用的聚合函数","content":"| 函数                | 说明         |\n| ----------------- | ---------- |\n| `VARIANCE(input)` | 求方差 [数字类型] |","table":"table-0"},"5626":{"id":"/docs/backend/database/base/aggregate_function-23","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#avg--sum-函数","content":"可以对数值型数据使用 AVG 和 SUM 函数。"},"5627":{"id":"/docs/backend/database/base/aggregate_function-24","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#min--max-函数","content":"可以对任意数据类型的数据使用 MIN 和 MAX 函数。"},"5628":{"id":"/docs/backend/database/base/aggregate_function-25","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"（1）`COUNT(*)`返回表中记录总数，适用于任意数据类型。"},"5629":{"id":"/docs/backend/database/base/aggregate_function-26","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"（2）`COUNT(expr)` 返回`expr`不为空的记录总数。"},"5630":{"id":"/docs/backend/database/base/aggregate_function-27","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"（1）用`count(*)`、`count(1)`、`count(列名)`谁好呢？"},"5631":{"id":"/docs/backend/database/base/aggregate_function-28","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"&#8195;&#8195;对于 MyISAM 引擎的表是没有区别的，这种引擎内部有一计数器在维护着行数；Innodb 引擎的表用 count(\\*)，count(1)直接读行数，复杂度是 O(n)，因为 innodb 真的要去数一遍，但好于具体的 count(列名)。"},"5632":{"id":"/docs/backend/database/base/aggregate_function-29","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"（2）能不能使用`count(列名)`替换`count(*)`？"},"5633":{"id":"/docs/backend/database/base/aggregate_function-30","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#count-函数","content":"&#8195;&#8195;不要使用`count(列名)`来替代`count(*)`，`count(*)`是 SQL92 定义的标准统计行数的语法，跟数据库无关，跟 NULL 和非 NULL 无关。  \n说明：count(\\*)会统计值为 NULL 的行，而 count(列名)不会统计此列为 NULL 值的行。"},"5634":{"id":"/docs/backend/database/base/aggregate_function-31","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#group-by","content":"**基本语法**："},"5635":{"id":"/docs/backend/database/base/aggregate_function-32","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#使用多个列分组","content":"① GROUP BY 子句至于 WHERE 子句后、ORDER BY 子句前，后面表达式必须包含字段，且不能使用列的别名；"},"5636":{"id":"/docs/backend/database/base/aggregate_function-33","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#使用多个列分组","content":"② 在 SELECT 子句中，只可以有组函数和分组字段(包括对分组字段的操作)，如果包括其他字段在 Oracle 中会报错，在 MySQL 中可能出现问题`（换言之，SELECT 中出现的非组函数字段必须声明在 GROUP BY 中；反之，GROUP BY 中的声明字段可以不出现在 SELECT 中）`；"},"5637":{"id":"/docs/backend/database/base/aggregate_function-34","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#使用多个列分组","content":"③ 如果 GROUP BY 子句后面要跟 ORDER BY 子句，则 ORDER BY 子句用于排序的字段必须是分组字段或组函数。"},"5638":{"id":"/docs/backend/database/base/aggregate_function-35","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#group-by-中使用-with-rollup","content":"使用`WITH ROLLUP`关键字之后，在所有查询出的分组记录之后增加一条记录，用于统计该分组的一些数据(根据 SELECT 子句中的组函数变化)。"},"5639":{"id":"/docs/backend/database/base/aggregate_function-36","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#group-by-中使用-with-rollup","content":"> 当使用`ROLLUP`时，不能同时使用 ORDER BY 子句进行结果排序，即 ROLLUP 和 ORDER BY 是互相排斥的。"},"5640":{"id":"/docs/backend/database/base/aggregate_function-37","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#基本使用-1","content":"HAVING 用来对分组结果进行约束。"},"5641":{"id":"/docs/backend/database/base/aggregate_function-38","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#基本使用-1","content":"① 当过滤条件中有聚合函数时，则此过滤条件必须声明在 HAVING 中；"},"5642":{"id":"/docs/backend/database/base/aggregate_function-39","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#基本使用-1","content":"② 当过滤条件中没有聚合函数时，则此过滤条件声明在 WHERE 或 HAVING 中都可以，但是建议声明在 WHERE 中，这样效率高。"},"5643":{"id":"/docs/backend/database/base/aggregate_function-40","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#where-和-having-对比","content":"**区别 1** ：WHERE 可以直接使用表中的字段作为筛选条件，但不能使用分组中的计算函数作为筛选条件；HAVING 必须要与 GROUP BY 配合使用，可以把分组计算的函数和分组字段作为筛选条件。  \n**区别 2** ：如果需要通过连接从关联表中获取需要的数据，WHERE 是先筛选后连接，而 HAVING 是先连接后筛选。  \n**选择**：WHERE 和 HAVING 也不是互相排斥的，我们可以在一个查询里面同时使用 WHERE 和 HAVING。包含分组统计函数的条件用 HAVING，普通条件用 WHERE。这样，我们就既利用了 WHERE 条件的高效快速，又发挥了 HAVING 可以使用包含分组统计函数的查询条件的优点。当数据量特别大的时候，运行效率会有很大的差别。"},"5644":{"id":"/docs/backend/database/base/aggregate_function-41","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#select-执行顺序","content":"（1）关键字的顺序"},"5645":{"id":"/docs/backend/database/base/aggregate_function-42","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#select-执行顺序","content":"（2）执行顺序"},"5646":{"id":"/docs/backend/database/base/aggregate_function-43","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;SELECT 是先执行 FROM 这一步的，在这个阶段，如果是多表联查，还会经历下面的几个步骤："},"5647":{"id":"/docs/backend/database/base/aggregate_function-44","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"> 1. 首先通过 CROSS JOIN 求笛卡尔积，相当于得到虚拟表`vt1-1`;\n> 2. 通过 ON 进行筛选，在虚拟表`vt1-1`的基础上进行筛选，得到虚拟表`vt1-2`;\n> 3. 添加外部行。如果我们使用的是左连接、右连接或者全连接，就会涉及到外部行，也就是在虚拟表`vt1-2`的基础上增加外部行，得到虚拟表`vt1-3`。\n>\n> 当然如果我们操作的是两张以上的表，还是重复上面的步骤，直到所有表都被处理完为止，这个过程得到是我们的原始数据。"},"5648":{"id":"/docs/backend/database/base/aggregate_function-45","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;当我们拿到了查询数据表的原始数据，也就是虚拟表`vt1`，就可以再次基础上再进行 WHERE 阶段。在这个阶段，会根据`vt1`表的结果进行筛选过滤，得到虚拟表`vt2`。"},"5649":{"id":"/docs/backend/database/base/aggregate_function-46","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;然后进入第三步和第四步，也就是 GROUP 和 HAVING 阶段，这个阶段会再`vt2`的基础上进行分组和分组过滤，得到中间的虚拟表`vt3`和`vt4`。"},"5650":{"id":"/docs/backend/database/base/aggregate_function-47","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;当完成了条件筛选部分之后，就可以筛选表中提取的字段，也就是进入到 SELECT 和 DISTINCT 阶段。首先在 SELECT 阶段会提取想要的字段，然后在 DISTINCT 阶段过滤重复的行，分别得到`vt5-1`和`vt5-2`。"},"5651":{"id":"/docs/backend/database/base/aggregate_function-48","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;当我们提取了想要的字段数据之后，就可以按照指定的字段进行排序，也就是 ORDER BY 阶段，得到虚拟表`vt6`。"},"5652":{"id":"/docs/backend/database/base/aggregate_function-49","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"&#8195;&#8195;最后在`vt6`的基础上，取出指定行的记录，也就是 LIMIT 阶段，得到最终的结果，对应的是虚拟表`vt7`。"},"5653":{"id":"/docs/backend/database/base/aggregate_function-50","page_id":"/docs/backend/database/base/aggregate_function","tags":[],"type":"text","url":"/docs/backend/database/base/aggregate_function#sql-的执行原理","content":"我们在写 SELECT 语句的时候，不一定存在所有的关键字，相应的阶段就会省略。"},"5654":{"id":"/docs/backend/database/base/constraint","page_id":"/docs/backend/database/base/constraint","type":"page","content":"约束","breadcrumbs":["主页","后端","数据库","MySQL基础篇"],"tags":[],"url":"/docs/backend/database/base/constraint"},"5655":{"id":"/docs/backend/database/base/constraint-0","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#约束constraint概述","content":"约束(constraint)概述"},"5656":{"id":"/docs/backend/database/base/constraint-1","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#为什么需要约束","content":"为什么需要约束"},"5657":{"id":"/docs/backend/database/base/constraint-2","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#什么叫约束","content":"什么叫约束?"},"5658":{"id":"/docs/backend/database/base/constraint-3","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#约束的分类","content":"约束的分类"},"5659":{"id":"/docs/backend/database/base/constraint-4","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#非空约束","content":"非空约束"},"5660":{"id":"/docs/backend/database/base/constraint-5","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#添加非空约束","content":"添加非空约束"},"5661":{"id":"/docs/backend/database/base/constraint-6","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除非空约束","content":"删除非空约束"},"5662":{"id":"/docs/backend/database/base/constraint-7","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#唯一性约束","content":"唯一性约束"},"5663":{"id":"/docs/backend/database/base/constraint-8","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#添加唯一索引","content":"添加唯一索引"},"5664":{"id":"/docs/backend/database/base/constraint-9","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#复合唯一约束","content":"复合唯一约束"},"5665":{"id":"/docs/backend/database/base/constraint-10","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除唯一约束","content":"删除唯一约束"},"5666":{"id":"/docs/backend/database/base/constraint-11","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#primary-key-约束","content":"PRIMARY KEY 约束"},"5667":{"id":"/docs/backend/database/base/constraint-12","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#添加主键约束","content":"添加主键约束"},"5668":{"id":"/docs/backend/database/base/constraint-13","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#复合主键约束","content":"复合主键约束"},"5669":{"id":"/docs/backend/database/base/constraint-14","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除主键约束","content":"删除主键约束"},"5670":{"id":"/docs/backend/database/base/constraint-15","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#自增列","content":"自增列"},"5671":{"id":"/docs/backend/database/base/constraint-16","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#添加自增列","content":"添加自增列"},"5672":{"id":"/docs/backend/database/base/constraint-17","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除自增列","content":"删除自增列"},"5673":{"id":"/docs/backend/database/base/constraint-18","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"MySQL 8.0 新特性—自增变量的持久化"},"5674":{"id":"/docs/backend/database/base/constraint-19","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#foreign-key-约束","content":"FOREIGN KEY 约束"},"5675":{"id":"/docs/backend/database/base/constraint-20","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#添加外键约束","content":"添加外键约束"},"5676":{"id":"/docs/backend/database/base/constraint-21","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#约束等级","content":"约束等级"},"5677":{"id":"/docs/backend/database/base/constraint-22","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除外键约束","content":"删除外键约束"},"5678":{"id":"/docs/backend/database/base/constraint-23","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#check-约束","content":"CHECK 约束"},"5679":{"id":"/docs/backend/database/base/constraint-24","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#default-约束","content":"DEFAULT 约束"},"5680":{"id":"/docs/backend/database/base/constraint-25","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#给字段设置默认值","content":"给字段设置默认值"},"5681":{"id":"/docs/backend/database/base/constraint-26","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#删除字段默认值","content":"删除字段默认值"},"5682":{"id":"/docs/backend/database/base/constraint-27","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#面试题","content":"面试题"},"5683":{"id":"/docs/backend/database/base/constraint-28","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#为什么建表时加not-null-default--或-default-0","content":"为什么建表时，加`NOT NULL DEFAULT '' 或 DEFAULT 0`"},"5684":{"id":"/docs/backend/database/base/constraint-29","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#为什么不想要null的值","content":"为什么不想要`null`的值"},"5685":{"id":"/docs/backend/database/base/constraint-30","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#带auto_increment约束的字段值是从-1-开始的吗","content":"带`AUTO_INCREMENT`约束的字段值是从 1 开始的吗?"},"5686":{"id":"/docs/backend/database/base/constraint-31","page_id":"/docs/backend/database/base/constraint","type":"heading","tags":[],"url":"/docs/backend/database/base/constraint#为什么说并不是每个表都可以任意选择存储引擎","content":"为什么说并不是每个表都可以任意选择存储引擎?"},"5687":{"id":"/docs/backend/database/base/constraint-32","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#为什么需要约束","content":"&#8195;&#8195;数据完整性(Data Integrity)是指数据的精确性(Accuracy)和可靠性(Reliability)。它是防止数据库中存在不符合语义规定的数据和防止因错误信息的输入输出造成无效操作和错误信息而提出的。"},"5688":{"id":"/docs/backend/database/base/constraint-33","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#为什么需要约束","content":"为了保证数据的完整性，SQL 规范以约束的方式对表数据进行额外的条件限制。从下面四个方面考虑：  \n① `实体完整性(Entity Integrity)`：例如，同一个表中，不能存在两条完全相同无法区分的记录  \n② `域完整性(Domain Integrity)`：例如：年龄范围 0-120，性别范围\"男/女\"  \n③ `引用完整性(Referential Integrity)`：例如：员工所在部门，在部门表中要能找到这个部门  \n④ `用户自定义完整性(User-defined Integrity)`：例如：用户名唯一、密码不能为空等"},"5689":{"id":"/docs/backend/database/base/constraint-34","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#什么叫约束","content":"&#8195;&#8195;约束简单来说就是对表中字段的限制，约束可以在创建表时通过`CREATE TABLE`语句，或者在表创建之后通过`ALTER TABLE`语句定义。"},"5690":{"id":"/docs/backend/database/base/constraint-35","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"**角度一**：数据列的限制  \n单列约束 ：每个约束只约束一列  \n多列约束 ：每个约束可约束多列数据"},"5691":{"id":"/docs/backend/database/base/constraint-36","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"**角度二**：作用范围  \n列级约束 ：只能作用在一个列上，跟在列的定义后面  \n表级约束 ：可以作用在多个列上，不与列一起，而是单独定义"},"5692":{"id":"/docs/backend/database/base/constraint-37","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"**角度三**：功能作用"},"5693":{"id":"/docs/backend/database/base/constraint-38","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束         | 说明              |\n| ---------- | --------------- |\n| `NOT NULL` | 非空约束，规定某个字段不能为空 |","table":"table-0"},"5694":{"id":"/docs/backend/database/base/constraint-39","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束       | 说明                   |\n| -------- | -------------------- |\n| `UNIQUE` | 唯一约束，规定某个字段在整个表中是唯一的 |","table":"table-0"},"5695":{"id":"/docs/backend/database/base/constraint-40","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束            | 说明          |\n| ------------- | ----------- |\n| `PRIMARY KEY` | 主键(非空且唯一)约束 |","table":"table-0"},"5696":{"id":"/docs/backend/database/base/constraint-41","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束            | 说明   |\n| ------------- | ---- |\n| `FOREIGN KEY` | 外键约束 |","table":"table-0"},"5697":{"id":"/docs/backend/database/base/constraint-42","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束      | 说明   |\n| ------- | ---- |\n| `CHECK` | 检查约束 |","table":"table-0"},"5698":{"id":"/docs/backend/database/base/constraint-43","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"| 约束        | 说明    |\n| --------- | ----- |\n| `DEFAULT` | 默认值约束 |","table":"table-0"},"5699":{"id":"/docs/backend/database/base/constraint-44","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"> 注意： MySQL 不支持 CHECK 约束，但可以使用 CHECK 约束，而没有任何效果"},"5700":{"id":"/docs/backend/database/base/constraint-45","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"查看某个表已有的约束："},"5701":{"id":"/docs/backend/database/base/constraint-46","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束的分类","content":"创建表时定义约束的语法："},"5702":{"id":"/docs/backend/database/base/constraint-47","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#非空约束","content":"**作用**：限制某个字段/某列的值不允许为空  \n**关键字**：`NOT NULL`  \n**特点**：  \n&#8195;① 默认，所有的类型的值都可以是`NULL`，包括`INT`、`FLOAT`等数据类型  \n&#8195;② 非空约束只能出现在表对象的列上，只能某个列单独限定非空，不能组合非空  \n&#8195;③ 一个表可以有很多列都分别限定了非空  \n&#8195;④ 空字符串`''`不等于`NULL`， 0 也不等于`NULL`"},"5703":{"id":"/docs/backend/database/base/constraint-48","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加非空约束","content":"**建表时**："},"5704":{"id":"/docs/backend/database/base/constraint-49","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加非空约束","content":"**建表后**："},"5705":{"id":"/docs/backend/database/base/constraint-50","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#唯一性约束","content":"**作用**：限制某个字段/某列的值不能重复  \n**关键字**：`UNIQUE`  \n**特点**：  \n&#8195;① 同一个表可以有多个唯一约束  \n&#8195;② 唯一约束可以是某一个列，也可以是多个列组合的值唯一  \n&#8195;③ 唯一约束允许列值为空  \n&#8195;④ 在创建唯一约束的时候，如果不给唯一约束命名，就默认和列名相同  \n&#8195;⑤ Mysql 会给唯一约束的列默认创建一个唯一索引"},"5706":{"id":"/docs/backend/database/base/constraint-51","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加唯一索引","content":"**建表时**："},"5707":{"id":"/docs/backend/database/base/constraint-52","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加唯一索引","content":"**示例**："},"5708":{"id":"/docs/backend/database/base/constraint-53","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加唯一索引","content":"**建表后**："},"5709":{"id":"/docs/backend/database/base/constraint-54","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加唯一索引","content":"**示例**："},"5710":{"id":"/docs/backend/database/base/constraint-55","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除唯一约束","content":"① 添加唯一约束的列会自动创建唯一索引  \n② 唯一约束只能通过删除唯一索引的方式删除  \n③ 删除时需要指定索引名，唯一索引名就和唯一约束名一样  \n④ 如果创建唯一索引未指定名称，如果是单列，默认就和列名相同；如果是组合列，那么默认和括号`()`中排在第一个的列名相同，也可以自定义唯一约束的约束名"},"5711":{"id":"/docs/backend/database/base/constraint-56","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#primary-key-约束","content":"**作用**：唯一标识表中的一行记录  \n**关键字**：`PRIMARY KEY`  \n**特点**：  \n&#8195;① 主键约束相当于`唯一约束 + 非空约束`的组合，主键约束列不允许重复，也不允许出现空值  \n&#8195;② 一个表最多只能有一个主键约束，建立主键约束可以在列级别创建，也可以在表级别上创建  \n&#8195;③ 主键约束对应着表中的一列或者多列（复合主键）  \n&#8195;④ 如果是多列组合的复合主键约束，那么这些列都不允许为空值，并且组合的值不允许重复  \n&#8195;⑤ MySQL 的主键名总是 PRIMARY ，就算自己命名了主键约束名也没用  \n&#8195;⑥ 当创建主键约束时，系统默认会在所在的列或列组合上建立对应的`主键索引`；如果删除主键约束，主键索引就会一起被删除"},"5712":{"id":"/docs/backend/database/base/constraint-57","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#primary-key-约束","content":"主键是数据记录的唯一标识，如果修改了主键的值，就有可能会破坏数据的完整性。"},"5713":{"id":"/docs/backend/database/base/constraint-58","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加主键约束","content":"**建表时**："},"5714":{"id":"/docs/backend/database/base/constraint-59","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加主键约束","content":"**示例**："},"5715":{"id":"/docs/backend/database/base/constraint-60","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加主键约束","content":"**建表后**："},"5716":{"id":"/docs/backend/database/base/constraint-61","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加主键约束","content":"**示例**："},"5717":{"id":"/docs/backend/database/base/constraint-62","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#自增列","content":"**作用**：某个字段的值自增  \n**关键字**：`AUTO_INCREMENT`  \n**特点**：  \n&#8195;① 一个表最多只能有一个自增长(zhǎng)列  \n&#8195;② 当需要产生唯一标识符或顺序值时，可设置自增长  \n&#8195;③ 自增长列约束的列必须是键列 (主键列，唯一键列)  \n&#8195;④ 自增约束的列的数据类型必须是整数类型  \n&#8195;⑤ 如果自增列指定了 0 和 null，会在当前最大值的基础上自增；如果自增列手动指定了具体值，直接赋值为具体值"},"5718":{"id":"/docs/backend/database/base/constraint-63","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加自增列","content":"**建表时**："},"5719":{"id":"/docs/backend/database/base/constraint-64","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加自增列","content":"**建表后**："},"5720":{"id":"/docs/backend/database/base/constraint-65","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"&#8195;&#8195;在 MySQL 8.0 之前，自增主键`AUTO_INCREMENT`的值如果大于`max(primary key) + 1`，在 MySQL 重启后，会重置`AUTO_INCREMENT = max(primary key) + 1`，这种现象在某些情况下会导致业务主键冲突或者其他难以发现的问题。"},"5721":{"id":"/docs/backend/database/base/constraint-66","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"在 MySQL 5.7 中测试如下："},"5722":{"id":"/docs/backend/database/base/constraint-67","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"1️⃣ 建表"},"5723":{"id":"/docs/backend/database/base/constraint-68","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"2️⃣ 插入 4 个空值"},"5724":{"id":"/docs/backend/database/base/constraint-69","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"3️⃣ 查询数据"},"5725":{"id":"/docs/backend/database/base/constraint-70","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"4️⃣ 删除 id 为 4 的记录，并继续插入一个空值"},"5726":{"id":"/docs/backend/database/base/constraint-71","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"5️⃣ 此时表中数据如下，id 为 4 的记录在上一步被删除了，再次插入并没有重用删除的 4，而是重新分配了 5"},"5727":{"id":"/docs/backend/database/base/constraint-72","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"6️⃣ 删除 id 为 5 的记录，并重启数据库，随后插入一个空值"},"5728":{"id":"/docs/backend/database/base/constraint-73","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"7️⃣ 查询当前数据库中的数据"},"5729":{"id":"/docs/backend/database/base/constraint-74","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"&#8195;&#8195;从结果中看出新插入的记录分配了 4，而根据前面分析的结论应该为 6。出现上述结果的主要原因是自增主键没有持久化。 在 MySQL 5.7 系统中，对于自增主键的分配规则，是由 InnoDB 数据字典内部一个`计数器`来决定的，而该计数器只在内存中维护，并不会持久化到磁盘中。当数据库重启时，该计数器会被初始化。"},"5730":{"id":"/docs/backend/database/base/constraint-75","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"&#8195;&#8195;我们在 MySQL 8.0 中重复上面的步骤，最后一步的结果如下："},"5731":{"id":"/docs/backend/database/base/constraint-76","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#mysql-80-新特性自增变量的持久化","content":"&#8195;&#8195;从结果来看说明自增变量做了持久化。MySQL 8.0 将自增主键的计数器持久化到`重做日志(Redo Log)`中。每次计数器发生改变，都会将其写入重做日志中。如果数据库重启，InnoDB 会根据重做日志中的信息来初始化计数器的内存值。"},"5732":{"id":"/docs/backend/database/base/constraint-77","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#foreign-key-约束","content":"**作用**：限定某个表的某个字段的引用完整性  \n**关键字**：`FOREIGN KEY`  \n**特点**：  \n&#8195;① 从表的外键列，必须引用/参考主表的主键或唯一约束的列(因为被依赖/参考的值必须是唯一的)  \n&#8195;② 在创建外键约束时，如果不给外键约束命名，默认名不是列名，而是自动产生一个外键名，此外也可以自行指定  \n&#8195;③ 创建表时就指定外键约束的话，先创建主表，再创建从表  \n&#8195;④ 删除表时，先删除从表(或先删除外键约束)，再删除主表  \n&#8195;⑤ 当主表的记录被从表参照时，主表的记录将不允许删除；如果要删除数据，需要先删除从表中的依赖该记录的数据，接着再删除主表的记录  \n&#8195;⑥ 在\"从表\"中指定外键约束，并且一个表可以有多个外键约束  \n&#8195;⑦ 从表的外键列和主表被参照的列名字可以不相同，但是数据类型必须一致。如果不一致，创建从表时出现`ERROR 1005 (HY000): Can't create table 'database.tablename'(errno: 150)`错误  \n&#8195;⑧ 当创建外键约束时，系统默认会在所在的列上建立对应的普通索引，但是索引名是外键的约束名  \n&#8195;⑨ 删除外键约束后，必须手动删除对应的索引"},"5733":{"id":"/docs/backend/database/base/constraint-78","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#foreign-key-约束","content":"主表(父表)：被引用的表，被参考的表  \n从表(子表)：引用别人的表，参考别人的表"},"5734":{"id":"/docs/backend/database/base/constraint-79","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加外键约束","content":"**建表时**："},"5735":{"id":"/docs/backend/database/base/constraint-80","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加外键约束","content":"**示例**："},"5736":{"id":"/docs/backend/database/base/constraint-81","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#添加外键约束","content":"**建表后**："},"5737":{"id":"/docs/backend/database/base/constraint-82","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"`CASCADE`：在父表上 update/delete 记录时，同步 update/delete 掉子表的匹配记录"},"5738":{"id":"/docs/backend/database/base/constraint-83","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"`SET NULL`：在父表上 update/delete 记录时，将子表上匹配记录的列设为 null，但是要注意子表的外键列不能为 not null"},"5739":{"id":"/docs/backend/database/base/constraint-84","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"`NO ACTION`：如果子表中有匹配的记录，则不允许对父表对应候选键进行 update/delete 操作"},"5740":{"id":"/docs/backend/database/base/constraint-85","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"`RESTRICT`：同`NO ACTION`， 都是立即检查外键约束"},"5741":{"id":"/docs/backend/database/base/constraint-86","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"`SET DEFAULT`：父表有变更时，子表将外键列设置成一个默认的值，但 Innodb 不能识别"},"5742":{"id":"/docs/backend/database/base/constraint-87","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#约束等级","content":"> 如果没有指定等级，就相当于`RESTRICT`方式，建议使用下面搭配：`ON UPDATE CASCADE ON DELETE RESTRICT`"},"5743":{"id":"/docs/backend/database/base/constraint-88","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"(1) 如果两个表之间有关系（一对一、一对多），比如：员工表和部门表（一对多），它们之间是否一定要建外键约束？（答：不是）"},"5744":{"id":"/docs/backend/database/base/constraint-89","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"(2) 建和不建外键约束有什么区别？"},"5745":{"id":"/docs/backend/database/base/constraint-90","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"建外键约束，你的操作（创建表、删除表、添加、修改、删除）会受到限制，从语法层面受到限制。例如：在员工表中不可能添加一个员工信息，它的部门的值在部门表中找不到。"},"5746":{"id":"/docs/backend/database/base/constraint-91","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"不建外键约束，你的操作（创建表、删除表、添加、修改、删除）不受限制，要保证数据的引用完整性，只能依靠程序员的自觉，或者是在 Java 程序中进行限定。例如：在员工表中，可以添加一个员工的信息，它的部门指定为一个完全不存在的部门。"},"5747":{"id":"/docs/backend/database/base/constraint-92","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"(3) 那么建和不建外键约束和查询有没有关系？（答：没有）"},"5748":{"id":"/docs/backend/database/base/constraint-93","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"> 在 MySQL 里，外键约束是有成本的，需要消耗系统资源。对于大并发的 SQL 操作，有可能会不适合。比如大型网站的中央数据库，可能会因为外键约束的系统开销而变得非常慢。所以， MySQL 允许你不使用系统自带的外键约束，在应用层面完成检查数据一致性的逻辑。也就是说，即使你不用外键约束，也要想办法通过应用层面的附加逻辑，来实现外键约束的功能，确保数据的一致性。"},"5749":{"id":"/docs/backend/database/base/constraint-94","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除外键约束","content":"> 阿里规范：  \n> 【强制】不得使用外键与级联，一切外键概念必须在应用层解决。  \n> 说明：（概念解释）学生表中的 student_id 是主键，那么成绩表中的 student_id 则为外键。如果更新学生表中的 student_id，同时触发成绩表中的 student_id 更新，即为级联更新。外键与级联更新适用于单机低并发，不适合分布式、高并发集群；级联更新是强阻塞，存在数据库更新风暴的风险；外键影响数据库的插入速度。"},"5750":{"id":"/docs/backend/database/base/constraint-95","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#check-约束","content":"**作用**：检查某个字段的值是否符合要求  \n**关键字**：`CHECK`"},"5751":{"id":"/docs/backend/database/base/constraint-96","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#check-约束","content":"在 MySQL 8.0.16 之前，CREATE TABLE 只允许以下有限版本的表 CHECK 约束语法，该语法被解析和忽略：`CHECK(exp)`，从 MySQL 8.0.16 支持`[CONSTRAINT [symbol]] CHECK (expr) [[NOT] ENFORCED]`  \n简单来说：MySQL 5.7 可以用 CHECK 但是没任何作用，而在 MySQL 8.0 后开始支持"},"5752":{"id":"/docs/backend/database/base/constraint-97","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#default-约束","content":"**作用**：为列设置默认值，如果没有指定其它值，默认值将添加到所有新记录中  \n**关键字**：`DEFAULT`"},"5753":{"id":"/docs/backend/database/base/constraint-98","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#给字段设置默认值","content":"**建表时**："},"5754":{"id":"/docs/backend/database/base/constraint-99","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#给字段设置默认值","content":"**示例**："},"5755":{"id":"/docs/backend/database/base/constraint-100","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#给字段设置默认值","content":"**建表后**："},"5756":{"id":"/docs/backend/database/base/constraint-101","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#给字段设置默认值","content":"**示例**："},"5757":{"id":"/docs/backend/database/base/constraint-102","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#删除字段默认值","content":"**示例**："},"5758":{"id":"/docs/backend/database/base/constraint-103","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#为什么建表时加not-null-default--或-default-0","content":"不想让表中出现`null`值"},"5759":{"id":"/docs/backend/database/base/constraint-104","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#为什么不想要null的值","content":"① 不好比较。`null`是一种特殊值，比较时只能用专门的`is null`和`is not null`来比较。碰到运算符，通常返回`null`。  \n② 效率不高。影响提高索引效果。因此，我们往往在建表时`not null default '' 或 default 0`"},"5760":{"id":"/docs/backend/database/base/constraint-105","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#带auto_increment约束的字段值是从-1-开始的吗","content":"&#8195;&#8195;在 MySQL 中，默认 AUTO_INCREMENT 的初始值是 1 ，每新增一条记录，字段值自动加 1 。设置自增属性（AUTO_INCREMENT）的时候，还可以指定第一条插入记录的自增字段的值，这样新插入的记录的自增字段值从初始值开始递增，如在表中插入第一条记录，同时指定 id 值为 5 ，则以后插入的记录的 id 值就会从 6 开始往上增加。添加主键约束时，往往需要设置字段自动增加属性。"},"5761":{"id":"/docs/backend/database/base/constraint-106","page_id":"/docs/backend/database/base/constraint","tags":[],"type":"text","url":"/docs/backend/database/base/constraint#为什么说并不是每个表都可以任意选择存储引擎","content":"&#8195;&#8195;外键约束（FOREIGN KEY）不能跨引擎使用。  \n&#8195;&#8195;MySQL 支持多种存储引擎，每一个表都可以指定一个不同的存储引擎，需要注意的是：外键约束是用来保证数据的参照完整性的，如果表之间需要关联外键，却指定了不同的存储引擎，那么这些表之间是不能创建外键约束的。所以说，存储引擎的选择也不完全是随意的。"},"5762":{"id":"/docs/backend/database/base/create_management_table","page_id":"/docs/backend/database/base/create_management_table","type":"page","content":"创建管理表","breadcrumbs":["主页","后端","数据库","MySQL基础篇"],"tags":[],"url":"/docs/backend/database/base/create_management_table"},"5763":{"id":"/docs/backend/database/base/create_management_table-0","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#基础知识","content":"基础知识"},"5764":{"id":"/docs/backend/database/base/create_management_table-1","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#一条数据存储的过程","content":"一条数据存储的过程"},"5765":{"id":"/docs/backend/database/base/create_management_table-2","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#标识符命名规则","content":"标识符命名规则"},"5766":{"id":"/docs/backend/database/base/create_management_table-3","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"MySQL 中的数据类型"},"5767":{"id":"/docs/backend/database/base/create_management_table-4","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#创建和管理数据库","content":"创建和管理数据库"},"5768":{"id":"/docs/backend/database/base/create_management_table-5","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#创建数据库","content":"创建数据库"},"5769":{"id":"/docs/backend/database/base/create_management_table-6","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#使用数据库","content":"使用数据库"},"5770":{"id":"/docs/backend/database/base/create_management_table-7","page_id":"/docs/backend/database/base/create_management_table","type":"heading","tags":[],"url":"/docs/backend/database/base/create_management_table#修改数据库","content":"修改数据库"},"5771":{"id":"/docs/backend/database/base/create_management_table-8","page_id":"/docs/backend/d