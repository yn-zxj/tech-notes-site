database/base/create_management_table#mysql-中的数据类型","content":"| 类型      | 类型举例                                             |\n| ------- | ------------------------------------------------ |\n| 文本字符串类型 | CHAR、 VARCHAR 、TINYTEXT、TEXT、MEDIUMTEXT、LONGTEXT |","table":"table-0"},"5799":{"id":"/docs/backend/database/base/create_management_table-36","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 类型   | 类型举例 |\n| ---- | ---- |\n| 枚举类型 | ENUM |","table":"table-0"},"5800":{"id":"/docs/backend/database/base/create_management_table-37","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 类型   | 类型举例 |\n| ---- | ---- |\n| 集合类型 | SET  |","table":"table-0"},"5801":{"id":"/docs/backend/database/base/create_management_table-38","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 类型       | 类型举例                                               |\n| -------- | -------------------------------------------------- |\n| 二进制字符串类型 | BINARY、VARBINARY、TINYBLOB、BLOB、MEDIUMBLOB、LONGBLOB |","table":"table-0"},"5802":{"id":"/docs/backend/database/base/create_management_table-39","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 类型      | 类型举例            |\n| ------- | --------------- |\n| JSON 类型 | JSON 对象、JSON 数组 |","table":"table-0"},"5803":{"id":"/docs/backend/database/base/create_management_table-40","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 类型     | 类型举例                                                                                              |\n| ------ | ------------------------------------------------------------------------------------------------- |\n| 空间数据类型 | 单值：GEOMETRY、POINT、LINESTRING、POLYGON集合：MULTIPOINT、MULTILINESTRING、MULTIPOLYGON、GEOMETRYCOLLECTION |","table":"table-0"},"5804":{"id":"/docs/backend/database/base/create_management_table-41","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"其中，常用的几类类型介绍如下："},"5805":{"id":"/docs/backend/database/base/create_management_table-42","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型  | 描述                                |\n| ----- | --------------------------------- |\n| `INT` | 从-2^31 到 2^31-1 的整型数据。存储大小为 4 个字节 |","table":"table-1"},"5806":{"id":"/docs/backend/database/base/create_management_table-43","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型         | 描述                             |\n| ------------ | ------------------------------ |\n| `CHAR(size)` | 定长字符数据。若未指定，默认为 1 个字符，最大长度 255 |","table":"table-1"},"5807":{"id":"/docs/backend/database/base/create_management_table-44","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型            | 描述                          |\n| --------------- | --------------------------- |\n| `VARCHAR(size)` | 可变长字符数据，根据字符串实际长度保存， 必须指定长度 |","table":"table-1"},"5808":{"id":"/docs/backend/database/base/create_management_table-45","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型         | 描述                                                                        |\n| ------------ | ------------------------------------------------------------------------- |\n| `FLOAT(M,D)` | 单精度，占用 4 个字节，M=整数位+小数位，D=小数位。 D&lt;=M&lt;=255,0&lt;=D&lt;=30，默认 M+D&lt;=6 |","table":"table-1"},"5809":{"id":"/docs/backend/database/base/create_management_table-46","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型          | 描述                                                        |\n| ------------- | --------------------------------------------------------- |\n| `DOUBLE(M,D)` | 双精度，占用 8 个字节，D&lt;=M&lt;=255,0&lt;=D&lt;=30，默认 M+D&lt;=15 |","table":"table-1"},"5810":{"id":"/docs/backend/database/base/create_management_table-47","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型           | 描述                                                                |\n| -------------- | ----------------------------------------------------------------- |\n| `DECIMAL(M,D)` | 高精度小数，占用 M+2 个字节，D&lt;=M&lt;=65，0&lt;=D&lt;=30，最大取值范围与 DOUBLE 相同。 |","table":"table-1"},"5811":{"id":"/docs/backend/database/base/create_management_table-48","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型   | 描述                   |\n| ------ | -------------------- |\n| `DATE` | 日期型数据，格式'YYYY-MM-DD' |","table":"table-1"},"5812":{"id":"/docs/backend/database/base/create_management_table-49","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型   | 描述                  |\n| ------ | ------------------- |\n| `BLOB` | 二进制形式的长文本数据，最大可达 4G |","table":"table-1"},"5813":{"id":"/docs/backend/database/base/create_management_table-50","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#mysql-中的数据类型","content":"| 数据类型   | 描述            |\n| ------ | ------------- |\n| `TEXT` | 长文本数据，最大可达 4G |","table":"table-1"},"5814":{"id":"/docs/backend/database/base/create_management_table-51","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#创建数据库","content":"**方式一**：创建数据库(默认字符集)"},"5815":{"id":"/docs/backend/database/base/create_management_table-52","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#创建数据库","content":"**方式二**：创建数据库并指定字符集"},"5816":{"id":"/docs/backend/database/base/create_management_table-53","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#创建数据库","content":"**方式三**：判断数据库是否已经存在，不存在则创建数据库 (推荐)"},"5817":{"id":"/docs/backend/database/base/create_management_table-54","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#创建数据库","content":"如果 MySQL 中已经存在相关的数据库，则忽略创建语句，不再创建数据库。"},"5818":{"id":"/docs/backend/database/base/create_management_table-55","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#使用数据库","content":"查看当前所有的数据库："},"5819":{"id":"/docs/backend/database/base/create_management_table-56","page_id":"/docs/backend/database/base/create_management_table","tags":[],"type":"text","url":"/docs/backend/database/base/create_management_table#使用数据库","content":"查看当前正在使用的数据库：